---
import Base from '../layouts/Base.astro';
import { md } from '../lib/content';
interface Props { title: string; source: string }
const { title, source } = Astro.props;
---
<Base title={title} editPath="seite">
  <article class="wrap legal">
    <h1>{title}</h1>
    <div class="prose" set:html={md(source)} />
  </article>
</Base>
<style>
  .legal { padding-block: clamp(24px, 5vw, 56px) clamp(56px, 8vw, 96px); }
  .legal h1 { font-size: var(--step-3); margin-bottom: 28px; }
</style>
