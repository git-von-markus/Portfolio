---
import { getImage } from 'astro:assets';
import { youtubeThumb } from '../lib/content';

interface Props { id: string; playlist?: boolean; title: string }
const { id, playlist = false, title } = Astro.props;
const embed = playlist
  ? `https://www.youtube-nocookie.com/embed/videoseries?list=${encodeURIComponent(id)}&autoplay=1`
  : `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
const thumbMeta = playlist ? undefined : youtubeThumb(id);
const thumb = thumbMeta ? await getImage({ src: thumbMeta, width: 1280, format: 'webp' }) : undefined;
---
<div class="yt" data-embed={embed} data-title={title}>
  {thumb && <img src={thumb.src} alt="" loading="lazy" decoding="async" />}
  <div class="yt-consent">
    <button type="button" class="btn yt-load">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6 4 L16 10 L6 16 Z" fill="currentColor" /></svg>
      {playlist ? 'Videoreihe laden' : 'Video laden'}
    </button>
    <p>Beim Laden wird eine Verbindung zu YouTube hergestellt. <a href="/datenschutz/">Mehr dazu</a></p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((box) => {
    box.querySelector('.yt-load')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.embed!;
      f.title = box.dataset.title ?? 'YouTube-Video';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      f.allowFullscreen = true;
      box.replaceChildren(f);
      box.classList.add('loaded');
    });
  });
</script>

<style>
  .yt {
    position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden;
    background:
      repeating-linear-gradient(115deg, transparent 0 22px, color-mix(in srgb, var(--accent) 14%, transparent) 22px 23px),
      var(--accent-soft);
  }
  .yt img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt-consent {
    position: absolute; left: 16px; bottom: 16px; right: 16px; max-width: 420px;
    background: var(--surface); color: var(--ink); border-radius: var(--radius);
    padding: 14px 16px; display: grid; gap: 8px; justify-items: start;
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.18);
  }
  .yt-consent p { margin: 0; font-size: var(--step--1); color: var(--ink-2); line-height: 1.45; }
</style>
