---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ModelViewer from '../../components/ModelViewer.astro';
import YouTube from '../../components/YouTube.astro';
import {
  getProjects, categoryTitle, md, resolveImage, fileUrl, coverImage, projectUrl, type Project,
} from '../../lib/content';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props { project: Project; prev?: Project; next?: Project }
const { project, prev, next } = Astro.props;
const d = project.data;

// Medien vorbereiten (Bilder optimiert, Grossansicht fuer die Lightbox)
const items = await Promise.all(
  d.media.map(async (m) => {
    if (m.type === 'image') {
      const meta = resolveImage(m.src);
      if (!meta) return null;
      const full = await getImage({ src: meta, width: Math.min(meta.width, 2200), format: 'webp', quality: 82 });
      return { ...m, meta, full: full.src };
    }
    if (m.type === 'video' || m.type === 'model') {
      const pm = resolveImage(m.poster);
      const poster = pm ? (await getImage({ src: pm, width: 1600, format: 'webp' })).src : undefined;
      return { ...m, url: fileUrl(m.src), posterUrl: poster };
    }
    return m;
  }),
).then((list) => list.filter((x) => x !== null));

const [lead, ...rest] = items;
const restImagesOnly = rest.length > 0 && rest.every((m) => m.type === 'image');
const facts = [
  ['Jahr', d.year], ['Rahmen', d.context], ['Meine Rolle', d.role], ['Team', d.team],
  ['Werkzeuge', d.tools.join(', ')],
].filter(([, v]) => v);
---
<Base title={d.title} description={d.summary || undefined} image={coverImage(project)} editPath={`projekt/${project.id}`}>
  <article class="wrap project">
    <a class="back" href="/#projekte">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M10 3 L5 8 L10 13" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      Alle Projekte
    </a>

    <header class="p-head">
      <p class="p-cat narrow"><a href={`/?bereich=${d.category}#projekte`}>{categoryTitle(d.category)}</a></p>
      <h1>{d.title}</h1>
      {d.summary && <p class="p-lead">{d.summary}</p>}
    </header>

    <div class="p-grid">
      <div class="p-main">
        {lead && (
          <div class="lead-media">
            <Fragment>
              {lead.type === 'image' && (
                <figure>
                  <button type="button" class="zoom" data-full={lead.full} data-alt={lead.alt} aria-label="Bild vergrößern">
                    <Image src={lead.meta} alt={lead.alt} widths={[640, 960, 1400, 1800]} sizes="(min-width: 1000px) 760px, 100vw" format="webp" quality={80} loading="eager" />
                  </button>
                  {lead.caption && <figcaption>{lead.caption}</figcaption>}
                </figure>
              )}
              {lead.type === 'video' && (
                <figure>
                  <video controls preload="none" playsinline poster={lead.posterUrl} src={lead.url}></video>
                  {lead.caption && <figcaption>{lead.caption}</figcaption>}
                </figure>
              )}
              {lead.type === 'model' && <figure><ModelViewer src={lead.url} poster={lead.posterUrl} alt={lead.alt || d.title} />{lead.caption && <figcaption>{lead.caption}</figcaption>}</figure>}
              {lead.type === 'youtube' && <figure><YouTube id={lead.id} title={d.title} />{lead.caption && <figcaption>{lead.caption}</figcaption>}</figure>}
              {lead.type === 'youtubePlaylist' && <figure><YouTube id={lead.id} playlist title={d.title} />{lead.caption && <figcaption>{lead.caption}</figcaption>}</figure>}
            </Fragment>
          </div>
        )}

        {rest.length > 0 && (
          <div class:list={['more-media', { thumbs: restImagesOnly && rest.length > 2 }]}>
            {rest.map((m) => (
              <figure>
                {m.type === 'image' && (
                  <button type="button" class="zoom" data-full={m.full} data-alt={m.alt} aria-label="Bild vergrößern">
                    <Image src={m.meta} alt={m.alt} widths={[360, 640, 960]} sizes="(min-width: 1000px) 380px, 50vw" format="webp" quality={78} />
                  </button>
                )}
                {m.type === 'video' && <video controls preload="none" playsinline poster={m.posterUrl} src={m.url}></video>}
                {m.type === 'model' && <ModelViewer src={m.url} poster={m.posterUrl} alt={m.alt || d.title} />}
                {m.type === 'youtube' && <YouTube id={m.id} title={d.title} />}
                {m.type === 'youtubePlaylist' && <YouTube id={m.id} playlist title={d.title} />}
                {m.caption && <figcaption>{m.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        {d.body && <div class="prose p-body" set:html={md(d.body)} />}

        {d.links.length > 0 && (
          <div class="btn-row p-links">
            {d.links.map((l, i) => (
              <a class:list={['btn', { ghost: i > 0 }]} href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>
            ))}
          </div>
        )}
      </div>

      {facts.length > 0 && (
        <aside class="p-facts" aria-label="Eckdaten">
          <dl class="narrow">
            {facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        </aside>
      )}
    </div>

    <nav class="pager" aria-label="Weitere Projekte">
      {prev ? <a href={projectUrl(prev)} class="pg prev"><span class="narrow muted">Vorheriges Projekt</span><span>{prev.data.title}</span></a> : <span />}
      {next ? <a href={projectUrl(next)} class="pg next"><span class="narrow muted">Nächstes Projekt</span><span>{next.data.title}</span></a> : <span />}
    </nav>
  </article>

  <dialog class="lightbox" id="lightbox" aria-label="Bildansicht">
    <img alt="" />
    <button type="button" class="lb-btn lb-close" aria-label="Schließen">
      <svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 4 L16 16 M16 4 L4 16" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <button type="button" class="lb-btn lb-prev" aria-label="Vorheriges Bild">
      <svg viewBox="0 0 20 20" width="18" height="18"><path d="M13 3 L6 10 L13 17" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
    <button type="button" class="lb-btn lb-next" aria-label="Nächstes Bild">
      <svg viewBox="0 0 20 20" width="18" height="18"><path d="M7 3 L14 10 L7 17" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </button>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dlg.querySelector('img')!;
  const zooms = [...document.querySelectorAll<HTMLButtonElement>('.zoom')];
  let idx = 0;

  function show(i: number) {
    idx = (i + zooms.length) % zooms.length;
    img.src = zooms[idx].dataset.full!;
    img.alt = zooms[idx].dataset.alt ?? '';
    dlg.classList.toggle('single', zooms.length < 2);
  }
  zooms.forEach((z, i) => z.addEventListener('click', () => { show(i); dlg.showModal(); }));
  dlg.querySelector('.lb-close')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
  dlg.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
  dlg.addEventListener('close', () => { img.removeAttribute('src'); });
</script>

<style>
  .project { padding-block: 8px clamp(56px, 8vw, 96px); }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: var(--step--1); color: var(--ink-2); text-decoration: none; }
  .back:hover { color: var(--accent-ink); }

  .p-head { margin: clamp(20px, 4vw, 40px) 0 clamp(28px, 4vw, 44px); max-width: 60rem; }
  .p-cat { margin: 0 0 12px; font-weight: 560; font-size: var(--step--1); }
  .p-cat a { text-decoration: none; }
  .p-head h1 { font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem); margin-bottom: 18px; }
  .p-lead { font-size: var(--step-1); line-height: 1.45; color: var(--ink-2); max-width: 44ch; margin: 0; }

  .p-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .p-facts { position: sticky; top: 24px; order: 2; }
  .p-facts dl { margin: 0; display: grid; gap: 0; }
  .p-facts div { border-top: 1px solid var(--line); padding: 10px 0; display: grid; gap: 2px; }
  .p-facts div:last-child { border-bottom: 1px solid var(--line); }
  .p-facts dt { color: var(--ink-2); font-size: var(--step--1); }
  .p-facts dd { margin: 0; font-size: 1rem; line-height: 1.4; }

  @media (max-width: 900px) {
    .p-grid { grid-template-columns: 1fr; }
    .p-facts { position: static; order: -1; }
  }

  figure { margin: 0; }
  figcaption { font-size: var(--step--1); color: var(--ink-2); margin-top: 8px; font-stretch: 90%; }
  .zoom { all: unset; display: block; cursor: zoom-in; border-radius: var(--radius); overflow: hidden; width: 100%; }
  .zoom:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .zoom img { width: 100%; height: auto; }
  .lead-media .zoom { width: fit-content; max-width: 100%; }
  .lead-media .zoom img { width: auto; max-width: 100%; max-height: min(80vh, 860px); }
  .lead-media video { width: 100%; border-radius: var(--radius); background: var(--surface); }
  .lead-media { margin-bottom: 18px; }
  .p-main > .p-body:first-child { margin-top: 0; }

  .more-media { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }
  .more-media.thumbs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .more-media.thumbs .zoom { aspect-ratio: 1; }
  .more-media.thumbs .zoom img { height: 100%; object-fit: cover; }
  .more-media video { width: 100%; border-radius: var(--radius); }
  @media (max-width: 600px) {
    .more-media { grid-template-columns: 1fr; }
    .more-media.thumbs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  }

  .p-body { margin-top: clamp(28px, 4vw, 44px); }
  .p-links { margin-top: 28px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: clamp(56px, 8vw, 96px); border-top: 1px solid var(--line); padding-top: 24px; }
  .pg { display: grid; gap: 2px; text-decoration: none; color: var(--ink); max-width: 30ch; }
  .pg span:last-child { font-weight: 600; font-stretch: 110%; }
  .pg:hover span:last-child { color: var(--accent-ink); text-decoration: underline; }
  .pg.next { justify-self: end; text-align: right; }

  .lightbox {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgb(10 14 20 / 0.94);
  }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { width: 100%; height: 100%; object-fit: contain; padding: 56px 64px; }
  .lb-btn {
    position: absolute; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgb(255 255 255 / 0.12); color: #fff; display: grid; place-items: center;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.24); }
  .lb-close { top: 14px; right: 14px; }
  .lb-prev { left: 14px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 14px; top: 50%; transform: translateY(-50%); }
  .lightbox.single .lb-prev, .lightbox.single .lb-next { display: none; }
  @media (max-width: 600px) { .lightbox img { padding: 56px 8px; } }
</style>
