---
import { Image } from 'astro:assets';
import { coverImage, categoryTitle, type Project } from '../lib/content';

interface Props {
  project: Project;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { project, widths, sizes, eager = false, class: className = '' } = Astro.props;
const img = coverImage(project);
const isVideo = project.data.media.some((m) => m.type === 'youtube' || m.type === 'youtubePlaylist' || m.type === 'video');
const position = project.data.coverPosition;
---
{img ? (
  <Image
    src={img}
    alt=""
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={78}
    loading={eager ? 'eager' : 'lazy'}
    class:list={['cover', className]}
    style={`object-position: center ${position}`}
  />
) : (
  <div class:list={['cover', 'cover-fallback', className]} aria-hidden="true">
    <span class="cf-cat">{categoryTitle(project.data.category)}</span>
    <span class="cf-title">{project.data.title}</span>
    {isVideo && (
      <svg class="cf-play" viewBox="0 0 40 40"><circle cx="20" cy="20" r="19" /><path d="M16 13 L28 20 L16 27 Z" /></svg>
    )}
  </div>
)}

<style>
  .cover { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cover-fallback {
    position: relative;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 6px;
    padding: clamp(14px, 3vw, 28px);
    background:
      repeating-linear-gradient(115deg, transparent 0 22px, color-mix(in srgb, var(--accent) 14%, transparent) 22px 23px),
      var(--accent-soft);
    color: var(--ink);
  }
  .cf-cat { font-stretch: 78%; font-size: 0.8rem; color: var(--accent-ink); font-weight: 560; }
  .cf-title { font-stretch: 122%; font-weight: 650; font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem); line-height: 1.15; max-width: 22ch; }
  .cf-play { position: absolute; top: clamp(14px, 3vw, 24px); right: clamp(14px, 3vw, 24px); width: 40px; height: 40px; }
  .cf-play circle { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .cf-play path { fill: var(--ink); }
</style>
